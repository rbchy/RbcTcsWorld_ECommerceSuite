{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Auth result",
  "description": "POST /api/auth/register and /api/auth/login",
  "type": "object",
  "required": [
    "token",
    "email",
    "role"
  ],
  "additionalProperties": false,
  "properties": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "role": {
      "type": "string",
      "enum": [
        "CUSTOMER",
        "ADMIN"
      ]
    }
  }
}
